{
  "ConnectionStrings": {
    "DefaultConnection": "Server=MF\\SQLEXPRESS01;Database=MyAppDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      },
      {
        "Name": "GrafanaLoki",
        "Args": {
          "uri": "http://localhost:3100",
          "labels": [
            {
              "key": "app",
              "value": "MyApp.Api"
            }
          ]
        }
      }
    ]
  },
  "Jwt": {
    "Secret": "a-very-long-random-secret-key-at-least-32-characters",
    "Issuer": "MyApp",
    "Audience": "MyAppClient"
  },
  "AllowedHosts": "*"
}